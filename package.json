{
  "name": "jobtrack",
  "private": true,
  "version": "0.1.0",
  "workspaces": ["apps/*"],
  "scripts": {
    "dev": "npm run dev --workspace=@jobtrack/api & npm run dev --workspace=@jobtrack/web",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "db:migrate": "npm run migration:run --workspace=@jobtrack/api",
    "db:seed": "npm run seed --workspace=@jobtrack/api"
  }
}

